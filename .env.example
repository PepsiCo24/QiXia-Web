# Required for the AI guide at /api/chat (Vercel AI Gateway).
# Copy this file to .env.local and provide your own key.
AI_GATEWAY_API_KEY=

# AMap JavaScript API 2.0 (browser key; distinct from the server REST key).
AMAP_KEY=

# Server-only walking REST API key: create a separate AMap "Web 服务" credential.
# Never use the browser JS API key here, and never add NEXT_PUBLIC_ to this name.
# Set this on the API deployment (Production/Preview as needed), then redeploy.
AMAP_WEB_SERVICE_KEY=

# Required unless NEXT_PUBLIC_AMAP_SERVICE_HOST is configured.
AMAP_SECURITY_JS_CODE=
# Existing NEXT_PUBLIC_AMAP_KEY / NEXT_PUBLIC_AMAP_SECURITY_JS_CODE are also supported.
# Optional trusted security proxy, e.g. https://maps.example.com/_AMapService
# The proxy must attach the security code on the server. GitHub Pages cannot host it.
NEXT_PUBLIC_AMAP_SERVICE_HOST=
