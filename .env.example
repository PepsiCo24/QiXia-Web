# Server-only credentials. Never prefix secrets with NEXT_PUBLIC_.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=google/gemini-3.8-flash
# Optional OpenAI-compatible provider (takes precedence when configured).
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
# Static frontend: public origin of your deployed Next Agent service, no /api/chat suffix.
NEXT_PUBLIC_AGENT_API_BASE_URL=
# Agent service: comma-separated allowed frontend origins, no trailing paths.
AGENT_ALLOWED_ORIGINS=https://pepsico24.github.io
# Optional static hosting settings (normally supplied by the Pages build).
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_GITHUB_PAGES=false
